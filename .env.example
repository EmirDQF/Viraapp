# Variables de entorno de VIRA. Copia este archivo a `.env` y completa los valores.
# `.env` está en .gitignore: nunca subas claves reales al repositorio.

# Solo servidor (ruta src/app/api/chat+api.ts). NUNCA uses el prefijo EXPO_PUBLIC_ para esta clave:
# todo lo que empieza con EXPO_PUBLIC_ termina dentro de la app y cualquiera podría leerlo.
ANTHROPIC_API_KEY=

# Solo servidor: pon "true" únicamente si la API está detrás de un proxy de confianza que reescribe
# X-Forwarded-For (por ejemplo, el de tu hosting). Si no, esas cabeceras se ignoran porque son falsificables.
TRUST_PROXY_HEADERS=false

# Público (opcional): origen del servidor donde se despliega la API, para que la app instalada
# pueda llamar a /api/chat en producción. Ejemplo: https://vira.example.com
EXPO_PUBLIC_API_ORIGIN=
